              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code adalah 200', function () {\r\n  pm.response.to.have.status(200);\r\n});\r\n\r\npm.test('Jurusan berubah, nama tetap', function () {\r\n  const jsonData = pm.response.json();\r\n  pm.expect(jsonData.kategori).to.eql('Pemerintahan');\r\n  pm.expect(jsonData.judul).to.eql('Ambisi Presiden di tahun 2026');\r\n});"
                ]
