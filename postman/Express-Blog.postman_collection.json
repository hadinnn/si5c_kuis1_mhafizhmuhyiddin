      "name": "A. CRUD",
      "item": [
        {
          "name": "GET Semua Artikel",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code adalah 200', function () {\r\n  pm.response.to.have.status(200);\r\n});\r\n\r\npm.test('Response berupa array', function () {\r\n  const jsonData = pm.response.json();\r\n  pm.expect(jsonData).to.be.an('array');\r\n});\r\n\r\npm.test('Setiap data memiliki id dan judul', function () {\r\n  const jsonData = pm.response.json();\r\n  jsonData.forEach((item) => {\r\n    pm.expect(item).to.have.property('id');\r\n    pm.expect(item).to.have.property('judul');\r\n  });\r\n});\r\n\r\npm.test('Response time di bawah 500ms', function () {\r\n  pm.expect(pm.response.responseTime).to.be.below(500);\r\n});\r\n\r\npm.test('Data artikel pertama berjudul Mengenal REST API', function () {\r\n  const jsonData = pm.response.json();\r\n  pm.expect(jsonData[0].judul).to.eql('Mengenal REST API');\r\n});\r\n\r\n"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/articles",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "articles"
              ]
            }
          },
          "response": []
        },
        {
          "name": "POST Tambah Artikel",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code adalah 201', function () {\r\n  pm.response.to.have.status(201);\r\n});\r\n\r\npm.test('Data baru memiliki id dan judul sesuai kiriman', function () {\r\n  const jsonData = pm.response.json();\r\n  pm.expect(jsonData).to.have.property('id');\r\n  pm.expect(jsonData.judul).to.eql('Ambisi Presiden di tahun 2026');\r\n});\r\n\r\nif (pm.response.code === 201) {\r\n  pm.environment.set('articlesId', pm.response.json().id);\r\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{api_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "    {\r\n        \"id\": 3,\r\n        \"judul\": \"Ambisi Presiden di tahun 2026\",\r\n        \"isi\": \"Presiden Republik Indonesia Prabowo Subianto memiliki tujuan ...\",\r\n        \"penulis\": \"Buna Teddy\",\r\n        \"kategori\": \"Politik\",\r\n        \"dipublikasikan\": false\r\n    }",
              "options": {
                "raw": {
                  "language": "json"
                }
