        {
          "name": "GET Satu Artikel",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code adalah 200', function () {\r\n  pm.response.to.have.status(200);\r\n});\r\n\r\npm.test('Data yang diambil adalah artikel yang berjudul Ambisi Presiden di tahun 2026', function () {\r\n  const jsonData = pm.response.json();\r\n  pm.expect(jsonData.id).to.eql(Number(pm.environment.get('articlesId')));\r\n  pm.expect(jsonData.judul).to.eql('Ambisi Presiden di tahun 2026');\r\n});"
                ]
              }
            }
